+      multi = {'num_problems': len(by_prob), 'K': K,
+               'pass_at_k': curve, 'maj_at_K': maj / max(1, len(by_prob))}
+      logger.info(f"pass@1={curve[1]*100:.2f}%  pass@{K}={curve[K]*100:.2f}%  "
