+    # ---- multi-sample metrics (pass@k, maj@k) when num_samples > 1 ----
+    # pass@k uses the unbiased Codex estimator 1 - C(n-c,k)/C(n,k), so ONE run at
+    # K samples/problem yields the whole curve k=1..K. maj@k is self-consistency:
+    # a plurality vote over EXECUTED answers, graded by the identical sandbox
+    # used for every method in the comparison.
+    multi = None
+    if any('problem_idx' in r for r in samples):
+      from collections import defaultdict, Counter
+      from math import comb
+      by_prob = defaultdict(list)
+      for rec, ok in zip(samples, per_sample_correct):
+        by_prob[rec['problem_idx']].append((int(ok), rec['response'],
+                                            rec['response_ground_truth']))
+      K = min(len(v) for v in by_prob.values())
+      def pass_at_k(n, c, k):
+        if n - c < k: return 1.0
+        return 1.0 - comb(n - c, k) / comb(n, k)
+      curve = {}
+      for k in range(1, K + 1):
+        curve[k] = float(np.mean([pass_at_k(len(v), sum(x[0] for x in v), k)
+                                  for v in by_prob.values()]))
+      maj = 0
