torch_compile_debug/
.torch_compile_cache/
.triton_cache/

# External baseline checkouts and isolated inference environments
external/
.venvs/

# Project-specific large/transient data
# datasets/  — symlinks to dataset caches; rebuild via scripts/lm1b/ and scripts/owt/
datasets/
# runs/      — training outputs, checkpoints, eval results
runs/
# logs/      — SLURM job logs and stdout/stderr captures
logs/
# hf_cache  — HuggingFace model cache symlink (gpt2-large, tokenizers, etc.)
hf_cache
hf_cache/
# wandb/     — Weights & Biases run directory
wandb/
generated_samples/
generated_output.png

# Model checkpoints (anywhere they accidentally land outside runs/)
*.pth
*.pt
*.ckpt
# Exception: entropy-rate schedule artefacts that ship with the repo and are
# loaded at evaluation time (assets/entropy_tables/<dataset>/entropy_*.pt).
!assets/entropy_tables/**/*.pt

# Crash dumps
core
core.*

# Cluster transfer staging: tarballs built by scripts/cluster/tar_data.sh and
# enroot squashfs images. Both are large, regenerable, and machine-specific.
_transfer/
*.sqsh
*.tar
*.tar.gz

# Local scratch artefacts that are not part of the deliverable.
m0_m1_work.html.orig
m0_v3_analsis.log
